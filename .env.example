# Copy this file to .env and fill in your own values. Never commit .env.
#
# Exchange API credentials. The env var name must be <EXCHANGE_ID>_API_KEY /
# <EXCHANGE_ID>_API_SECRET, matching exchange.id in config/config.yaml
# (e.g. BINANCE_API_KEY for exchange.id: binance).
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Live trading safety gates ---
# Both of these AND runtime.dry_run: false in config.yaml are required
# before the bot will place a single real order. Leave them unset/false
# until you have backtested and paper-traded the strategy and are
# deliberately choosing to risk real funds.
LIVE_TRADING=false
LIVE_TRADING_CONFIRM=
