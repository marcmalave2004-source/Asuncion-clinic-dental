# Copy this file to .env and fill in your own values. Never commit .env.
#
# --- ccxt provider (crypto exchanges) ---
# The env var name must be <EXCHANGE_ID>_API_KEY / <EXCHANGE_ID>_API_SECRET,
# matching exchange.id in config/config.yaml (e.g. BINANCE_API_KEY for
# exchange.id: binance).
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- trading212 provider (stocks/ETFs) ---
# Generate this in the Trading 212 app under Settings > API. If it gives you
# a single key, leave TRADING212_API_SECRET blank. If it gives you a
# key+secret pair, fill in both. See trading_bot/t212_client.py for why this
# is flagged as unverified - run `python -m trading_bot.main check-broker`
# to confirm it works before doing anything else.
TRADING212_API_KEY=
TRADING212_API_SECRET=

# --- Live trading safety gates ---
# Both of these AND runtime.dry_run: false in config.yaml are required
# before the bot will place a single real order. Leave them unset/false
# until you have backtested and paper-traded the strategy and are
# deliberately choosing to risk real funds.
LIVE_TRADING=false
LIVE_TRADING_CONFIRM=
